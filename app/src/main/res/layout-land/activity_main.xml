<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the picture stays clear; controls sit along the left edge (settings, voice) and the right edge
     (flip, shutter, gallery) like a normal camera app. Same view ids as the portrait layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:background="@drawable/grad_top" />

    <View
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/grad_right" />

    <!-- left edge: settings and voice -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="Settings: default wait and recording length"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="Voice control on or off"
            android:padding="10dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <!-- top centre: recording timer and what the camera is doing -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="70dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="150dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rec"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="● 0:00"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/status_start"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/hint_example"
            android:textColor="#E6F0ECE4"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="16"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="110sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- bottom centre: zoom pills -->
    <LinearLayout
        android:id="@+id/zoomRow"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="150dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- next to the right edge: VIDEO / PHOTO -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="104dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/modeVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="VIDEO"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="PHOTO"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- right edge: flip, shutter, last take -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="22dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnFlip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="Switch between front and back camera"
            android:padding="11dp"
            android:src="@drawable/ic_flip" />

        <FrameLayout
            android:id="@+id/btnShutter"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Start or stop">

            <View
                android:id="@+id/shutterRing"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_ring" />

            <View
                android:id="@+id/shutterInner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_video" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnTakes"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_thumb"
            android:clipToOutline="true"
            android:contentDescription="Review your videos and photos">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/thumbBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge"
                android:minWidth="18dp"
                android:paddingHorizontal="5dp"
                android:text="0"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
